# Base URL mà FE gọi. Để trống/`/api` thì đi qua dev proxy của Vite (tránh lỗi CORS).
VITE_API_BASE_URL=/api

# Địa chỉ backend NestJS thật, dùng cho proxy của Vite dev server.
VITE_API_PROXY_TARGET=http://localhost:5000

# true = bỏ qua đăng nhập, vào thẳng khu quản trị với tài khoản giả lập.
# Đặt lại false khi đã có auth thật / trước khi build production.
VITE_AUTH_DISABLED=true
